[Unit]
Description=Apache Hive Metastore
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=hive
Group=hive
WorkingDirectory=/var/lib/hive
# Каталог логов задаётся через JVM, а не --hiveconf (HIVE-19886)
Environment="HADOOP_CLIENT_OPTS=-Dhive.log.dir=/var/log/hive -Dhive.log.file=metastore.log"
ExecStart=/opt/hive/bin/hive --service metastore
Restart=on-failure
RestartSec=15
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
