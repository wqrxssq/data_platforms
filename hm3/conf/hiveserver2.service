[Unit]
Description=Apache HiveServer2
After=network-online.target
Wants=network-online.target

[Service]
User=hive
Group=hive
WorkingDirectory=/var/lib/hive
# Каталог логов задаётся через JVM, а не --hiveconf (HIVE-19886)
Environment="HADOOP_CLIENT_OPTS=-Dhive.log.dir=/var/log/hive -Dhive.log.file=hiveserver2.log"
Environment=HIVESERVER2_PID_DIR=/var/lib/hive
ExecStart=/opt/hive/bin/hive --service hiveserver2
Restart=on-failure
RestartSec=15
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
